# Salin ke .env. Isi nilai lokal sendiri; jangan commit .env.
DATABASE_URL=postgresql://eish:GANTI_PASSWORD_LOKAL@localhost:5432/eish?schema=public
POSTGRES_USER=eish
POSTGRES_PASSWORD=GANTI_PASSWORD_LOKAL
POSTGRES_DB=eish
APP_URL=http://localhost:3000
# Minimal 32 karakter acak; dipakai untuk hash pembatasan percobaan login.
AUTH_SECRET=GANTI_DENGAN_NILAI_ACAK_MINIMAL_32_KARAKTER
# Hanya development/test; seed menolak NODE_ENV=production.
SEED_PASSWORD=GANTI_PASSWORD_DUMMY_MINIMAL_12_KARAKTER
